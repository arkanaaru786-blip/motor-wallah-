# ---------------------------------------------------------------------------
# Motor Wallah — local environment
# Copy to `.env` (git-ignored) for local runs, and set the same names in the
# deployment environment. Never commit real values.
#
# VITE_* values are compiled into the browser bundle, so treat them as public
# build inputs, not secrets: the admin panel uses them to verify the sign-in
# credential on the client.
# ---------------------------------------------------------------------------

# Master Admin control room (/master-admin).
# Set BOTH to manage the administrator credential from the environment instead
# of the in-app first-run setup. The hash is the SHA-256 of the password as
# lowercase hex — generate it with:
#   npm run admin:hash -- "your password"
# Leave both blank to let the first visit to /master-admin enrol the owner
# account in the app database (stored as a salted PBKDF2 hash).
VITE_MASTER_ADMIN_EMAIL=
VITE_MASTER_ADMIN_PASSWORD_HASH=

# Optional CRM/webhook URL that receives every lead captured by the site.
VITE_LEAD_ENDPOINT=

# Supabase (cloud database). The publishable key is public: row level security
# in supabase/schema.sql is what protects the data.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Razorpay (prepaid checkout for parts and decor). The Key ID is public; the
# secret is read only by the server (src/lib/payments.ts) and must never be
# prefixed with VITE_.
VITE_RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
