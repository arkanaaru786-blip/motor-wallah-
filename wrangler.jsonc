{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "motor-wallah",
  "compatibility_date": "2025-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "main": "dist/server/index.mjs",
  "assets": {
    "directory": "dist",
    "binding": "ASSETS"
  },
  "observability": { "enabled": true }
}
